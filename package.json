{
  "name": "yahala-usa-linktree",
  "type": "module",
  "version": "0.4.0",
  "scripts": {
    "lint:a11y": "eslint src --cache --cache-location .cache/eslint-a11y --max-warnings 0",
    "test:a11y": "playwright test --config playwright.a11y.config.ts --project=mobile-light --project=desktop-dark",
    "test:a11y:full": "playwright test --config playwright.a11y.config.ts",
    "a11y": "npm run lint:a11y && npm run build && npm run test:a11y",
    "dev": "astro dev",
    "start": "astro dev",
    "update:youtube": "node scripts/update-latest-youtube-video.mjs",
    "generate:og": "node scripts/generate-og-images.mjs",
    "update:visited-videos": "node scripts/update-visited-videos.mjs && node scripts/update-business-locations.mjs",
    "update:business-locations": "node scripts/update-business-locations.mjs",
    "validate:data": "node scripts/validate-youtube-data.mjs",
    "validate:ui": "node scripts/validate-ui-consistency.mjs",
    "test:ui-validation": "node scripts/test-ui-consistency-validator.mjs",
    "test:base-ui": "node scripts/test-base-ui-migration.mjs",
    "test:testimonials": "node scripts/test-testimonials.mjs",
    "test:requests": "node scripts/test-requests.mjs",
    "test:site-navigation": "node scripts/test-site-navigation.mjs",
    "test:accessibility": "node scripts/test-accessible-shell.mjs && node scripts/test-search-accessibility.mjs && node scripts/test-share-accessibility.mjs",
    "test:locations": "node scripts/test-location-utils.mjs",
    "test:youtube-id": "node scripts/test-youtube-video-id.mjs",
    "test:youtube-catalog": "node scripts/test-youtube-channel-catalog.mjs",
    "test:video-search": "node scripts/test-video-search.mjs",
    "test:preview-smoke": "node scripts/test-preview-smoke.mjs",
    "test:reach-chart": "node scripts/test-reach-chart.mjs",
    "test:atlas-polish": "node scripts/test-atlas-polish.mjs",
    "test:motion-toggle": "node scripts/test-motion-toggle.mjs",
    "test:visited-map": "node scripts/test-visited-map.mjs && node scripts/test-story-map.mjs",
    "test:story-coverage": "node scripts/test-story-coverage.mjs",
    "test:editorial-motion": "node scripts/test-editorial-motion.mjs",
    "test:video-recency": "node scripts/test-video-recency.mjs",
    "test:branded-document": "node scripts/test-branded-page-document.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "perf:lighthouse": "node scripts/perf-lighthouse.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:branch-workflow": "node scripts/test-branch-workflow.mjs",
    "test:dependabot": "node scripts/test-dependabot-automation.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.5",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.101",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.17.0",
    "motion": "^14.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/geojson": "^7946.0.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.159.0"
  }
}
