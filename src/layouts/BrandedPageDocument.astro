---
import '../styles.css'
import '../atlas.css'
import EditorialHeader from '../components/EditorialHeader.astro'

import { cloudflareBeaconToken, getBaseUrl } from '../lib/site-config'

type Props = {
  bodyClass: string
}

const { bodyClass } = Astro.props
const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
---

<!doctype html>
<html lang="en" class="box-border light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href={`${baseUrl}favicon.ico`} sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${baseUrl}favicon-16x16.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${baseUrl}favicon-32x32.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${baseUrl}apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${baseUrl}site.webmanifest`} />
    <meta name="theme-color" content="#ffffff" />
    <slot name="head" />
    <script type="module">
      import '../scripts/image-fallback'
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <EditorialHeader />
    <slot />
    {cloudflareBeaconToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken })}
      />
    )}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 100;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-paper);
    color: var(--color-ink);
    transform: translateY(calc(-100% - var(--space-md)));
  }
  .skip-link:focus {
    transform: none;
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
