---
import '../styles.css'
import '../atlas.css'

import { getBaseUrl } from '../lib/site-config'

type Props = {
  bodyClass: string
}

const { bodyClass } = Astro.props
const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
---

<!doctype html>
<html lang="en" class="box-border">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href={`${baseUrl}favicon.ico`} sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${baseUrl}favicon-16x16.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${baseUrl}favicon-32x32.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${baseUrl}apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${baseUrl}site.webmanifest`} />
    <meta name="theme-color" content="#ffffff" />
    <slot name="head" />
    <script type="module">
      import '../scripts/image-fallback'
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
