---
import '../styles.css'
import '../atlas.css'
import EditorialHeader from '../components/EditorialHeader.astro'

import { cloudflareBeaconToken, getBaseUrl } from '../lib/site-config'

type Props = {
  bodyClass: string
}

const { bodyClass } = Astro.props
const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
// theme-color cannot read CSS variables; keep equal to --background in tokens.css.
const themeColor = { light: '#f8f8fc', dark: '#10101c' } // ui-color-allow: browser chrome color needs literals
---

<!doctype html>
<html lang="en" class="box-border">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={themeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColor.dark}
      media="(prefers-color-scheme: dark)"
    />
    <!-- Blocking and unbundled so the stored theme applies before first paint; the Worker stamps its CSP nonce. -->
    <script is:inline>
      ;(() => {
        const key = 'theme'
        // ui-color-allow: theme-color cannot read CSS variables; keep equal to --background in tokens.css.
        const colors = { light: '#f8f8fc', dark: '#10101c' }
        const media = matchMedia('(prefers-color-scheme: dark)')
        const root = document.documentElement
        const read = () => {
          try {
            const value = localStorage.getItem(key)
            return value === 'light' || value === 'dark' ? value : 'system'
          } catch {
            return 'system'
          }
        }
        const apply = (preference = read()) => {
          const theme =
            preference === 'dark' || (preference === 'system' && media.matches)
              ? 'dark'
              : 'light'
          // The map reads the light/dark class to pick its basemap.
          root.classList.toggle('dark', theme === 'dark')
          root.classList.toggle('light', theme === 'light')
          root.style.colorScheme = theme
          root.dataset.themePreference = preference
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((meta) => {
              meta.content =
                colors[
                  preference === 'system'
                    ? meta.media.includes('dark')
                      ? 'dark'
                      : 'light'
                    : theme
                ]
            })
          root.dispatchEvent(new CustomEvent('themechange'))
        }
        const set = (preference) => {
          try {
            if (preference === 'system') localStorage.removeItem(key)
            else localStorage.setItem(key, preference)
          } catch {}
          root.classList.add('no-transitions')
          apply(preference)
          requestAnimationFrame(() =>
            requestAnimationFrame(() =>
              root.classList.remove('no-transitions'),
            ),
          )
        }
        window.yahalaTheme = { read, set }
        apply()
        media.addEventListener('change', () => read() === 'system' && apply())
        addEventListener('storage', (event) => event.key === key && apply())
      })()
    </script>
    <link rel="icon" href={`${baseUrl}favicon.ico`} sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${baseUrl}favicon-16x16.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${baseUrl}favicon-32x32.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${baseUrl}apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${baseUrl}site.webmanifest`} />
    <slot name="head" />
    <script type="module">
      import '../scripts/image-fallback'
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <EditorialHeader />
    <slot />
    {cloudflareBeaconToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken })}
      />
    )}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 100;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    background: var(--background);
    color: var(--foreground);
    transform: translateY(calc(-100% - var(--space-md)));
  }
  .skip-link:focus {
    transform: none;
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
