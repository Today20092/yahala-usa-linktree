---
// Cnippet's image-reveal, progress, and highlight ideas adapted for static Astro content.
---

<div class="reading-progress" aria-hidden="true"></div>

<script>
  const elements = document.querySelectorAll<HTMLElement>(
    '[data-image-reveal], [data-text-highlight], [data-scroll-section]',
  )
  if (
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'IntersectionObserver' in window
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('editorial-visible')
            observer.unobserve(entry.target)
          }
        }
      },
      { threshold: 0.1 },
    )
    elements.forEach((element) => {
      element.classList.add('editorial-motion-ready')
      observer.observe(element)
    })
  }
</script>

<style is:global>
  [data-scroll-section].editorial-motion-ready {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }
  [data-scroll-section].editorial-visible,
  [data-scroll-section]:focus-within,
  [data-motion-paused] [data-scroll-section] {
    opacity: 1;
    transform: none;
  }
  [data-motion-paused] [data-scroll-section] {
    transition: none;
  }
  [data-image-reveal].editorial-motion-ready {
    clip-path: inset(0 0 12% 0);
    transition: clip-path 650ms var(--ease-out);
  }
  [data-image-reveal].editorial-visible {
    clip-path: inset(0);
  }
  [data-text-highlight] {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-position: 0 90%;
    background-repeat: no-repeat;
    background-size: 100% 30%;
    padding-inline: 0.08em;
  }
  [data-text-highlight].editorial-motion-ready {
    background-size: 0% 30%;
    transition: background-size 600ms var(--ease-out);
  }
  [data-text-highlight].editorial-visible {
    background-size: 100% 30%;
  }
  .reading-progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      display: block;
      position: fixed;
      inset: 0 0 auto;
      height: 3px;
      background: var(--primary);
      transform-origin: left;
      z-index: 60;
      pointer-events: none;
      animation: reading-progress linear both;
      animation-timeline: scroll(root);
    }
    @keyframes reading-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
  [data-motion-paused] [data-image-reveal] {
    clip-path: none;
  }
  [data-motion-paused] [data-text-highlight] {
    background-size: 100% 30%;
  }
  [data-motion-paused] .reading-progress {
    display: none;
  }
  [data-motion-paused] [data-image-reveal],
  [data-motion-paused] [data-text-highlight] {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-scroll-section].editorial-motion-ready {
      opacity: 1;
      transform: none;
      transition: none;
    }
    [data-image-reveal].editorial-motion-ready {
      clip-path: none;
      transition: none;
    }
    [data-text-highlight].editorial-motion-ready {
      background-size: 100% 30%;
      transition: none;
    }
    .reading-progress {
      display: none;
    }
  }
</style>
