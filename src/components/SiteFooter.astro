---
import {
  cloudflareBeaconToken,
  getBaseUrl,
  siteConfig,
} from '../lib/site-config'

const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
const links = [
  ['Home', baseUrl],
  ['About', `${baseUrl}about`],
  ['Stories', `${baseUrl}stories`],
  ['Contact', `${baseUrl}contact`],
]
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<footer class="ui-meta border-border/70 mt-auto w-full border-t px-4 pt-10 pb-6 text-center sm:px-6">
  <nav
    class="mx-auto mb-3 flex max-w-xl flex-wrap items-center justify-center gap-x-1 gap-y-0"
    aria-label="Page information"
  >
    {links.map(([label, href]) => (
      <a
        href={href}
        class="hover:text-foreground inline-flex min-h-11 items-center px-2 transition-colors"
        aria-current={
          (href.replace(/\/$/, '') || '/') === currentPath ? 'page' : undefined
        }
      >
        {label}
      </a>
    ))}
  </nav>
  <slot />
  <p
    id="privacy"
    class="text-muted-foreground mx-auto mb-3 max-w-xl text-sm text-balance"
  >
    Privacy: this site links to third-party platforms and remote media.
    {cloudflareBeaconToken &&
      ' Cookieless Cloudflare analytics count page views.'}
  </p>
  <p class="mb-0.5">
    &copy; {new Date().getFullYear()} {siteConfig.site.siteName}. All rights
    reserved.
  </p>
</footer>
