---
import { Icon } from 'astro-icon/components'
import QRCode from 'qrcode'

const pageUrl = Astro.url.toString()
const displayUrl = (() => {
  try {
    const url = new URL(pageUrl)
    return `${url.host}${url.pathname}${url.search}${url.hash}`
  } catch {
    return pageUrl.replace(/^https?:\/\//, '')
  }
})()
const qrDataUrl = await QRCode.toDataURL(pageUrl, {
  color: {
    dark: '#020617', // ui-color-allow: QR raster needs fixed max-contrast pixels, not theme tokens
    light: '#ffffff', // ui-color-allow: QR raster needs fixed max-contrast pixels, not theme tokens
  },
  errorCorrectionLevel: 'M',
  margin: 2,
  width: 512,
})
---

<div class="mx-auto mb-5 flex justify-center">
  <a
    href="#qr-dialog"
    data-qr-open
    class="text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-2 rounded-xl px-3 py-2 text-sm underline underline-offset-4 focus-visible:ring-2 focus-visible:outline-none"
    aria-haspopup="dialog"
    aria-controls="qr-dialog"
  >
    <Icon name="heroicons:qr-code" class="size-5" aria-hidden="true" />
    <span>Share with a QR code</span>
  </a>
</div>

<dialog
  id="qr-dialog"
  class="bg-foreground/70 fixed inset-0 z-50 m-0 hidden h-dvh max-h-none w-dvw max-w-none items-center justify-center overflow-y-auto border-0 px-4 py-6 backdrop-blur-sm target:flex sm:py-8"
  aria-modal="true"
  aria-labelledby="qr-title"
>
  <div class="bg-background text-foreground elevation-4 max-h-[calc(100dvh-3rem)] w-full max-w-[22rem] overflow-y-auto rounded-xl p-4 text-center sm:p-5">
    <div class="mb-4 flex items-center justify-between gap-4 text-left">
      <h2 id="qr-title" class="ui-card-title">
        Share this page
      </h2>
      <button
        type="button"
        id="qr-close"
        class="hover:bg-accent focus-visible:ring-ring/30 grid size-11 place-items-center rounded-full transition-colors focus-visible:ring-2 focus-visible:outline-none"
        aria-label="Close QR code"
      >
        <Icon name="heroicons:x-mark" class="size-6" aria-hidden="true" />
      </button>
    </div>
    <div class="to-primary/10 from-background via-background elevation-3 mx-auto grid aspect-square w-full max-w-64 place-items-center rounded-xl bg-gradient-to-br p-3">
      <img
        src={qrDataUrl}
        alt=""
        width="224"
        height="224"
        class="bg-background h-full w-full max-w-56 rounded-xl p-1"
        aria-hidden="true"
      />
    </div>
    <a
      href={pageUrl}
      data-qr-destination
      class="text-muted-foreground hover:text-foreground focus-visible:ring-ring/30 mx-auto mt-4 block max-w-full text-[clamp(0.75rem,3.6vw,0.875rem)] font-medium break-all underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:outline-none"
      title={pageUrl}
    >
      {displayUrl}
    </a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#qr-dialog')
  const openButtons = document.querySelectorAll<HTMLElement>('[data-qr-open]')
  const closeButton = document.querySelector<HTMLElement>('#qr-close')
  let previousFocus: HTMLElement | null = null

  const openDialog = (trigger: HTMLElement | null = null) => {
    if (!dialog || dialog.open) return

    previousFocus =
      trigger ??
      (document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null)
    dialog.classList.remove('hidden')
    dialog.classList.add('flex')
    dialog.showModal()
    document.documentElement.classList.add('overflow-hidden')
    closeButton?.focus()
  }

  const closeDialog = () => {
    dialog?.close()
  }

  dialog?.addEventListener('close', () => {
    if (dialog.matches(':target')) {
      history.replaceState(null, '', `${location.pathname}${location.search}`)
    }
    dialog.classList.add('hidden')
    dialog.classList.remove('flex')
    document.documentElement.classList.remove('overflow-hidden')

    if (previousFocus instanceof HTMLElement) {
      previousFocus.focus()
    }
  })

  openButtons.forEach((button) => {
    button.setAttribute('role', 'button')
    button.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== ' ') return
      event.preventDefault()
      openDialog(button)
    })
    button.addEventListener('click', (event) => {
      event.preventDefault()
      openDialog(button)
    })
  })
  closeButton?.addEventListener('click', (event) => {
    event.preventDefault()
    closeDialog()
  })

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeDialog()
  })

  if (dialog?.matches(':target')) openDialog()
</script>
