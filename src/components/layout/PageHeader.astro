---
import { cn } from '../../lib/utils'
import Cluster from './Cluster.astro'

interface Props {
  eyebrow?: string
  titleId?: string
  class?: string
}

const { eyebrow, titleId, class: className } = Astro.props
const hasEyebrow = Boolean(eyebrow) || Astro.slots.has('eyebrow')
---

<header class={cn('max-w-3xl', className)}>
  {hasEyebrow && (
    <p class="ui-kicker-accent">
      <slot name="eyebrow">{eyebrow}</slot>
    </p>
  )}
  <h1 id={titleId} class={cn('ui-page-title', hasEyebrow && 'mt-2')}>
    <slot name="title" />
  </h1>
  {Astro.slots.has('description') && (
    <div class="text-muted-foreground mt-4 text-base leading-relaxed sm:text-lg">
      <slot name="description" />
    </div>
  )}
  {Astro.slots.has('actions') && (
    <Cluster gap={3} class="mt-8">
      <slot name="actions" />
    </Cluster>
  )}
</header>
