---
import type { HTMLAttributes, HTMLTag } from 'astro/types'
import { cn } from '../../lib/utils'

// page: the documented 76rem shell with 20–32px gutters (homepage, shared header grid).
// wide: About and Story Browser. content: the 72rem grid as a standalone block. narrow: one form column.
const sizes = {
  page: 'max-w-[76rem] px-[clamp(1.25rem,3vw,2rem)]',
  wide: 'max-w-7xl px-4 sm:px-6 lg:px-8',
  content: 'max-w-6xl px-4 sm:px-6',
  narrow: 'max-w-3xl px-4 sm:px-6',
}

type Props = HTMLAttributes<'div'> & {
  as?: HTMLTag
  size?: keyof typeof sizes
}

const {
  as: Tag = 'div',
  size = 'page',
  class: className,
  ...rest
} = Astro.props
---

<Tag class={cn('mx-auto box-border w-full', sizes[size], className)} {...rest}>
  <slot />
</Tag>
