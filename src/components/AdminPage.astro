---
import { SEO } from 'astro-seo'
import BrandedPageDocument from '../layouts/BrandedPageDocument.astro'
import Cluster from './layout/Cluster.astro'
import Container from './layout/Container.astro'
import PageHeader from './layout/PageHeader.astro'
import SiteFooter from './SiteFooter.astro'
import { buttonVariants } from './ui/button'
import './partnership.css'

// Frame for the Cloudflare Access-protected admin pages; see docs/testimonials.md.
interface Props {
  title: string
  description: string
  current: '/admin' | '/admin/requests'
}
const { title, description, current } = Astro.props
const sections = [
  { href: '/admin', label: 'Testimonials' },
  { href: '/admin/requests', label: 'Requests' },
] as const
---

<BrandedPageDocument bodyClass="min-h-screen text-lg text-foreground">
  <Fragment slot="head">
    <SEO
      title={`${title} admin | Ya Hala`}
      description={description}
      noindex
      nofollow
    />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <Container
    as="main"
    id="main-content"
    tabindex="-1"
    size="wide"
    class="partnership-section flex flex-col gap-8 py-10 sm:py-14"
  >
    <div class="flex flex-col gap-3">
      <Cluster as="nav" aria-label="Admin sections" gap={2}>
        {sections.map(({ href, label }) => (
          <a
            href={href}
            aria-current={href === current ? 'page' : undefined}
            class={buttonVariants({
              variant: href === current ? 'secondary' : 'ghost',
              className: 'min-h-11 px-3',
            })}
          >
            {label}
          </a>
        ))}
      </Cluster>
      <PageHeader eyebrow="Admin">
        <Fragment slot="title">{title}</Fragment>
        <p slot="description" class="max-w-prose">
          {description}
        </p>
      </PageHeader>
    </div>
    <slot />
    <noscript>
      <p>Enable JavaScript to use this page.</p>
    </noscript>
  </Container>
  <SiteFooter />
</BrandedPageDocument>
