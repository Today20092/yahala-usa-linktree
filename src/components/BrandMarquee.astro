---
import MotionToggle from './MotionToggle.astro'

type Props = {
  brands: {
    name: string
    logo?: string
  }[]
}

const { brands } = Astro.props
const rows = [
  brands.filter((_, index) => index % 2 === 0),
  brands.filter((_, index) => index % 2 === 1),
]
---

{brands.length > 0 && (
  <section
    class="brand-marquee ui-section-block"
    aria-labelledby="brand-marquee-title"
  >
    <div class="brand-marquee__header ui-section-header flex flex-col items-center gap-2">
      <h2 id="brand-marquee-title" class="ui-section-title">
        Brands we've collaborated with
      </h2>
      <MotionToggle controls="brand-marquee-rows" />
    </div>

    <div id="brand-marquee-rows" class="brand-marquee__viewport">
      {rows.map((row, rowIndex) => (
        <div
          class:list={[
            'brand-marquee__track',
            { 'brand-marquee__track--reverse': rowIndex === 1 },
          ]}
        >
          {[false, true].map((duplicate) => (
            <ul class="brand-marquee__group" aria-hidden={duplicate}>
              {row.map((brand) => (
                <li class="brand-marquee__brand">
                  {brand.logo && (
                    <span
                      class="brand-marquee__mark"
                      data-ink-plate={
                        brand.logo.includes('lipari-foods') ||
                        brand.logo.includes('excite-medical')
                      }
                    >
                      <img
                        src={brand.logo}
                        alt=""
                        class="brand-marquee__logo"
                        width="104"
                        height="44"
                        loading="eager"
                        decoding="async"
                      />
                    </span>
                  )}
                  <span>{brand.name}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .brand-marquee {
    width: 100%;
    overflow: hidden;
  }

  .brand-marquee__header {
    width: 100%;
    text-align: left;
  }

  .brand-marquee__viewport {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .brand-marquee__track {
    display: flex;
    width: max-content;
    animation: brand-marquee-scroll 45s linear infinite;
  }

  .brand-marquee__track--reverse {
    animation-direction: reverse;
    animation-duration: 50s;
  }

  .brand-marquee__viewport:hover .brand-marquee__track,
  .brand-marquee__viewport:focus-within .brand-marquee__track,
  [data-motion-paused] .brand-marquee__track {
    animation-play-state: paused;
  }

  .brand-marquee__group {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0 0.5rem;
    list-style: none;
  }

  .brand-marquee__brand {
    display: flex;
    min-height: 5.5rem;
    min-width: 12rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    padding: 1rem 1.5rem;
    color: var(--card-foreground);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  .brand-marquee__logo {
    width: 6.5rem;
    height: 2.75rem;
    flex-shrink: 0;
    padding: var(--space-3xs);
    border-radius: var(--radius-md);
    background: var(--logo-plate);
    object-fit: contain;
  }

  .brand-marquee__mark {
    display: contents;
  }

  @keyframes brand-marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-marquee__viewport {
      overflow: visible;
      mask-image: none;
    }

    .brand-marquee__track {
      animation: none;
      width: 100%;
      transform: none;
    }

    .brand-marquee__group {
      flex-wrap: wrap;
      width: 100%;
      padding: 0;
    }

    .brand-marquee__brand {
      min-width: 0;
      max-width: 100%;
      flex-wrap: wrap;
    }

    .brand-marquee__group[aria-hidden='true'] {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .brand-marquee__header {
      align-items: flex-start;
    }

    .brand-marquee__header :global(.motion-toggle) {
      display: none;
    }

    .brand-marquee__viewport {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 2rem 1.5rem;
      overflow: visible;
      mask-image: none;
    }

    .brand-marquee__track,
    .brand-marquee__group {
      display: contents;
      animation: none;
    }

    .brand-marquee__group[aria-hidden='true'] {
      display: none;
    }

    .brand-marquee__brand {
      min-width: 0;
      min-height: 0;
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0.75rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 0;
      color: var(--muted-foreground);
      font-size: 0.8rem;
      font-weight: 500;
      line-height: 1.5;
    }

    .brand-marquee__mark {
      display: flex;
      width: 100%;
      height: 5rem;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--logo-plate);
    }

    .brand-marquee__mark[data-ink-plate='true'] {
      background: var(--color-scrim);
    }

    .brand-marquee__logo {
      width: 8rem;
      max-width: 85%;
      height: 4rem;
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    /* These source images contain extra whitespace around the actual mark. */
    .brand-marquee__logo[src$='/farooj.png'] {
      height: 8rem;
    }

    .brand-marquee__logo[src$='/moka-and-co.png'] {
      width: 9rem;
      max-width: 95%;
    }
  }
</style>
