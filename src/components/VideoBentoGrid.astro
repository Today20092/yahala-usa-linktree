---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { parse } from 'yaml'

import { IconBadge } from './ui/icon-badge'
import latestYoutubeVideos from '../data/latest-youtube-videos.json'
import visitedVideosYaml from '../data/visited-videos.yaml?raw'
import { siteConfig } from '../lib/site-config'
import {
  getYoutubeVideoId,
  resolveYoutubeThumbnailUrl,
  resolveYoutubeVideos,
  youtubeThumbnailFallbackUrl,
} from '../lib/youtube-videos'

type BentoImage = {
  type: 'video'
  src: string | ImageMetadata
  alt: string
  href: string
}

type GeneratedYoutubeVideo = {
  videoId: string
  title: string
  url: string
  thumbnail: string
}

type VisitedVideoCatalog = {
  videos?: {
    videoId?: string
    title?: string
    url?: string
    thumbnail?: string
  }[]
}

const bentoImageModules = import.meta.glob('../bento/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
})

const youtubeChannelUrl =
  siteConfig.socialLinks.find((link) => link.id === 'youtube')?.url ??
  siteConfig.youtubeChannels[0]?.videosUrl ??
  'https://www.youtube.com/'
const youtubeVideoUrl = (videoId: string) =>
  `https://www.youtube.com/watch?v=${videoId}`
const isRemoteImage = (src: BentoImage['src']): src is string =>
  typeof src === 'string'
const getThumbnailFallback = (href: string) => {
  const videoId = getYoutubeVideoId(href)
  return videoId ? youtubeThumbnailFallbackUrl(videoId) : undefined
}
const placeholderTitles = new Set([
  'Watch on YouTube',
  'Open on YouTube',
  'Ya Hala YouTube video thumbnail',
])
const cleanVideoTitle = (title?: string) => {
  const trimmedTitle = title?.trim()

  if (!trimmedTitle || placeholderTitles.has(trimmedTitle)) {
    return 'Ya Hala field story'
  }

  return trimmedTitle
}

const bentoImages = Object.entries(bentoImageModules)
  .filter(([path]) => !path.includes('.DS_Store'))
  .map(([path, image]): BentoImage => {
    const filename = decodeURIComponent(path.split('/').pop() ?? '')
    const videoId = filename.match(/\[([A-Za-z0-9_-]{11})\b/)?.[1]
    const title = filename
      .replace(/\.[^.]+$/, '')
      .replace(/\s*\[[^\]]+\](?:\s*\(\d+\))?$/, '')
      .replace(/^Ya Hala with Haithum ياهلا مع هيثم\s*-\s*/, '')
      .trim()

    return {
      type: 'video',
      src: image as ImageMetadata,
      alt: title || 'Ya Hala YouTube video screenshot',
      href: videoId ? youtubeVideoUrl(videoId) : youtubeChannelUrl,
    }
  })
  .sort((a, b) => {
    const seedA = Array.from(a.alt).reduce((sum, char) => {
      return sum + char.charCodeAt(0)
    }, 0)
    const seedB = Array.from(b.alt).reduce((sum, char) => {
      return sum + char.charCodeAt(0)
    }, 0)

    return (seedA % 997) - (seedB % 997)
  })

const generatedYoutubeImages = Object.values(latestYoutubeVideos)
  .flatMap(
    (channel) => (channel as { videos?: GeneratedYoutubeVideo[] }).videos ?? [],
  )
  .map((video): BentoImage => ({
    type: 'video',
    src: resolveYoutubeThumbnailUrl(video.videoId, video.thumbnail),
    alt: cleanVideoTitle(video.title),
    href: video.url || youtubeVideoUrl(video.videoId),
  }))

const visitedVideoImages = resolveYoutubeVideos(
  (parse(visitedVideosYaml) as VisitedVideoCatalog).videos ?? [],
)
  .filter((video) => video !== undefined)
  .map((video): BentoImage => ({
    type: 'video',
    src: video.thumbnail,
    alt: cleanVideoTitle(video.title),
    href: video.url || youtubeVideoUrl(video.videoId),
  }))

const dedupeImagesByHref = (images: BentoImage[]) => {
  const seen = new Set<string>()

  return images.filter((image) => {
    if (seen.has(image.href)) return false

    seen.add(image.href)
    return true
  })
}

const videoThumbnailImages = dedupeImagesByHref([
  ...generatedYoutubeImages,
  ...visitedVideoImages,
])
const bentoImageHrefs = new Set(videoThumbnailImages.map((image) => image.href))
const maxCarouselImages = 18
const carouselImages = [
  ...videoThumbnailImages,
  ...bentoImages.filter((image) => !bentoImageHrefs.has(image.href)),
].slice(0, maxCarouselImages)

const gridImages = carouselImages.slice(0, 6)
---

{gridImages.length > 0 && (
  <section
    class="ui-section-block animate-fade-in-up mx-auto w-full max-w-xl px-4 delay-300 sm:px-6"
    aria-labelledby="video-showcase-title"
  >
    <div class="video-bento-frame overflow-hidden">
      <div class="video-bento-header flex items-center justify-center gap-3 px-4 py-3 text-center sm:px-5 sm:py-4">
        <IconBadge
          tone="solid"
          size="md"
          style={{
            '--ui-icon-badge-accent': 'var(--primary)',
            '--ui-icon-badge-foreground': 'var(--primary-foreground)',
          }}
          className="shadow-sm"
        >
          <Icon
            name="heroicons:play-20-solid"
            class="size-4"
            aria-hidden="true"
          />
        </IconBadge>
        <h2 id="video-showcase-title" class="ui-section-title min-w-0">
          Moments from Ya Hala stories
        </h2>
      </div>
      <ul
        class="grid grid-cols-2 gap-2 p-2.5 sm:gap-3 lg:grid-cols-3 sm:p-3"
        data-portfolio-grid
      >
        {gridImages.map((item, itemIndex) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Play story — ${item.alt} (opens on YouTube)`}
              class="group bento-video-link bg-accent focus-visible:outline-ring border-border/60 hover:border-youtube/70 hover:ring-youtube/30 relative isolate block aspect-video w-full cursor-pointer overflow-hidden rounded-lg border text-left shadow-sm ring-1 ring-transparent transition duration-200 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-3 focus-visible:outline-offset-2"
            >
              {isRemoteImage(item.src) ? (
                <img
                  src={item.src}
                  alt={item.alt}
                  width="480"
                  height="270"
                  data-fallback-src={getThumbnailFallback(item.href)}
                  class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  loading={itemIndex > 1 ? 'lazy' : 'eager'}
                  decoding="async"
                />
              ) : (
                <Image
                  src={item.src}
                  alt={item.alt}
                  width={480}
                  height={270}
                  class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  loading={itemIndex > 1 ? 'lazy' : 'eager'}
                  decoding="async"
                />
              )}
              <span
                class="from-scrim/80 via-scrim/40 absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t to-transparent p-3 pt-10 text-white opacity-95 transition duration-200 group-hover:opacity-100"
                aria-hidden="true"
              >
                <span class="bg-card/95 text-card-foreground ring-border inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold shadow-sm ring-1 backdrop-blur-sm">
                  <Icon
                    name="heroicons:play-20-solid"
                    class="size-3.5 sm:hidden"
                    aria-hidden="true"
                  />
                  <span class="hidden sm:inline">Play story</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="px-4 pb-4 text-center sm:px-5">
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}stories`}
          class="hero-explore-link"
        >
          See all stories
        </a>
      </p>
    </div>
  </section>
)}

<style>
  @media (prefers-reduced-motion: reduce) {
    .bento-video-link,
    .bento-video-link img {
      transition: none;
      transform: none;
    }
  }
</style>
