---
import StoryMapShell from './StoryMapShell'
import type { VisitedPlaces } from '../lib/site-config'
import { buildStories } from '../lib/story-browser'
import { buildStoryMapPlaces } from '../lib/story-map'
import StoryCoverage from './StoryCoverage.astro'

type Props = {
  visitedPlaces: VisitedPlaces
}

const { visitedPlaces } = Astro.props
const stories = buildStories(visitedPlaces)
const mapPlaces = buildStoryMapPlaces(visitedPlaces.mapPlaces ?? [], stories)
---

{visitedPlaces.places?.length > 0 && (
  <section
    class="ui-section-block animate-fade-in-up mx-auto w-full max-w-xl px-4 text-left delay-400 sm:px-6"
    aria-labelledby="visited-places-title"
  >
    <div class="ui-section-header">
      <h2 id="visited-places-title" class="ui-section-title">
        {visitedPlaces.title}
      </h2>
      {visitedPlaces.description && (
        <p class="ui-body mx-auto mt-3 max-w-md text-center text-sm">
          {visitedPlaces.description}
        </p>
      )}
    </div>

    <div class="visited-places-frame p-2.5 sm:p-3">
      <StoryMapShell
        client:visible={{ rootMargin: '200px' }}
        places={mapPlaces}
      />

      <p class="text-muted-foreground mt-2 px-2 text-sm">
        Business addresses where available; city pins are approximate. Grouped
        pins count locations, not stories.
      </p>

      <div class="visited-places-support">
        <StoryCoverage stories={stories} />
      </div>
    </div>
  </section>
)}

<style>
  .visited-places-support {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .visited-places-support :global(.story-coverage) {
    min-width: 0;
    margin-block-start: 0;
    padding-block-start: 0;
    border-block-start: 0;
  }
</style>
