---
import { Icon } from 'astro-icon/components'
import TextReveal from './TextReveal.astro'

import { CountingNumber } from './animate-ui/primitives/texts/counting-number'

type ReachItem = {
  platform: string
  metric: string
  value: number
  updatedAt?: string
}

type ReachBadgeProps = {
  total: number
  updatedAt: string
  items: ReachItem[]
  highlights?: { label: string; value: number }[]
}

const {
  total,
  updatedAt,
  items,
  highlights = [],
} = Astro.props as ReachBadgeProps

const platformIcons: Record<string, string> = {
  YouTube: 'simple-icons:youtube',
  TikTok: 'simple-icons:tiktok',
  Instagram: 'simple-icons:instagram',
  Facebook: 'simple-icons:facebook',
}

const platformColors: Record<
  string,
  {
    accent: string
    darkAccent: string
  }
> = {
  YouTube: {
    accent: 'var(--social-youtube)',
    darkAccent: 'var(--social-youtube-dark)',
  },
  TikTok: {
    accent: 'var(--social-tiktok)',
    darkAccent: 'var(--social-tiktok-dark-2)',
  },
  Instagram: {
    accent: 'var(--social-instagram)',
    darkAccent: 'var(--social-instagram-dark)',
  },
  Facebook: {
    accent: 'var(--social-facebook)',
    darkAccent: 'var(--social-facebook-dark)',
  },
}

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(date))

const groupedPlatforms = Object.values(
  items.reduce<Record<string, { platform: string; total: number }>>(
    (totals, item) => {
      totals[item.platform] ??= { platform: item.platform, total: 0 }
      totals[item.platform].total += item.value
      return totals
    },
    {},
  ),
).sort((a, b) => b.total - a.total || a.platform.localeCompare(b.platform))
const largestPlatformTotal = groupedPlatforms[0]?.total ?? 0
const platformTotals = groupedPlatforms.map((item) => {
  const colors = platformColors[item.platform] ?? {
    accent: 'var(--primary)',
    darkAccent: 'var(--primary)',
  }

  return {
    ...item,
    icon: platformIcons[item.platform] ?? 'heroicons:chart-bar',
    share:
      largestPlatformTotal > 0 ? (item.total / largestPlatformTotal) * 100 : 0,
    ...colors,
  }
})
---

<aside
  data-reach-card
  data-reach-chart
  class="ui-section-block animate-fade-in-up delay-300"
  aria-label="Total video views"
>
  <div class="reach-summary">
    <header class="reach-summary__headline">
      <div class="reach-summary__heading-row">
        <h2 class="ui-section-title">
          <TextReveal text="Total views" preset="slide" />
        </h2>
      </div>

      <p
        class="reach-summary__total"
        aria-label={`${total.toLocaleString('en-US')} recorded views`}
      >
        <CountingNumber
          client:visible
          number={Math.floor(total / 1_000_000)}
          locale="en-US"
          inView
          inViewOnce
        />
        <span>M</span>
        <span class="text-primary">+</span>
      </p>
      <p class="ui-body reach-summary__description">
        Recorded video views across YouTube, TikTok, Instagram, and Facebook.
      </p>
      <p class="ui-meta mt-2">
        Recorded views, not unique viewers. Platform figures dated below.
      </p>
      {highlights.length > 0 && (
        <dl class="reach-summary__highlights">
          {highlights.map((item) => (
            <div>
              <dt class="ui-meta">{item.label}</dt>
              <dd class="text-foreground text-2xl font-bold tabular-nums">
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </header>

    <div class="reach-summary__stats">
      {platformTotals.map((item) => (
        <div
          style={`--platform-active-accent: light-dark(${item.accent}, ${item.darkAccent}); --platform-share: ${item.share}%;`}
          class="reach-summary__stat"
        >
          <dl class="reach-summary__stat-row m-0">
            <dt class="ui-meta flex min-w-0 items-center gap-2 truncate">
              <Icon
                name={item.icon}
                class="size-3.5 shrink-0 text-[var(--platform-active-accent)]"
                aria-hidden="true"
              />
              <span class="truncate">{item.platform}</span>
            </dt>
            <dd
              class="text-foreground text-sm font-semibold tabular-nums sm:text-base"
              aria-label={`${item.total.toLocaleString('en-US')} recorded views`}
            >
              <CountingNumber
                client:visible
                number={Math.floor(item.total / 1_000_000)}
                locale="en-US"
                inView
                inViewOnce
                delay={100}
              />
              <span>M+</span>
              <span class="text-muted-foreground ml-1 text-xs font-normal">
                views
              </span>
            </dd>
          </dl>
          <p class="ui-meta text-left">
            Updated{' '}
            {formatDate(
              items.find((entry) => entry.platform === item.platform)
                ?.updatedAt ?? updatedAt,
            )}
          </p>
          <div class="reach-summary__bar" aria-hidden="true">
            <span />
          </div>
        </div>
      ))}
    </div>
  </div>
</aside>

<style>
  .reach-summary__highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-md);
    margin-block-start: var(--space-md);
  }

  .reach-summary__highlights dd {
    margin: 0;
  }

  .reach-summary__highlights > div {
    display: flex;
    flex-direction: column-reverse;
  }

  [data-reach-chart] .reach-summary__stats {
    display: grid;
    gap: var(--space-md);
    margin: 0;
  }

  [data-reach-chart] .reach-summary__stat {
    min-width: 0;
    padding: 0;
    background: transparent;
  }

  [data-reach-chart] .reach-summary__bar {
    height: var(--space-2xs);
    margin-block-start: var(--space-2xs);
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  [data-reach-chart] .reach-summary__bar > span {
    display: block;
    width: var(--platform-share);
    height: 100%;
    transform-origin: left;
    border-radius: inherit;
    background: var(--platform-active-accent);
  }
</style>
