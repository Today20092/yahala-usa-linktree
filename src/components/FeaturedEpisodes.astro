---
import { Icon } from 'astro-icon/components'

import { IconBadge } from './ui/icon-badge'

import snapshot from '../data/story-view-snapshot.json'
import {
  youtubeThumbnailFallbackUrl,
  youtubeThumbnailUrl,
  youtubeVideosById,
} from '../lib/youtube-videos'

type Episode = {
  thumbnail: string
  title: string
  href: string
  viewCount: number
  videoId: string
}

const capturedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(snapshot.capturedAt))

const formatViews = (views: number) =>
  Intl.NumberFormat('en', {
    notation: views >= 10000 ? 'compact' : 'standard',
    maximumFractionDigits: views >= 10000 ? 1 : 0,
  }).format(views)

const episodes = snapshot.entries
  .slice(0, 3)
  .map(({ videoId, views }): Episode | null => {
    const video = youtubeVideosById[videoId]
    if (!video) return null

    return {
      thumbnail: video.thumbnail ?? youtubeThumbnailUrl(videoId),
      title: video.title,
      href: video.url ?? `https://www.youtube.com/watch?v=${videoId}`,
      viewCount: views,
      videoId,
    }
  })
  .filter((episode): episode is Episode => Boolean(episode))
---

{episodes.length > 0 && (
  <section
    class="ui-section-block animate-fade-in-up mx-auto w-full max-w-xl px-4 text-left delay-400 sm:px-6"
    aria-labelledby="featured-episodes-title"
  >
    <div class="ui-section-header">
      <h2 id="featured-episodes-title" class="ui-section-title">
        Most Viewed Episodes
      </h2>
    </div>

    <ol class="border-border divide-border grid divide-y border-y">
      {episodes.map((episode) => (
        <li>
          <a
            href={episode.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group hover:bg-card/60 focus-visible:ring-ring/30 focus-visible:ring-offset-background grid grid-cols-[7rem_minmax(0,1fr)] items-center gap-4 py-5 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-5"
          >
            <span class="bg-muted relative aspect-video w-full overflow-hidden rounded-lg">
              <img
                src={episode.thumbnail}
                alt={episode.title}
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
                data-fallback-src={youtubeThumbnailFallbackUrl(episode.videoId)}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <span
                class="bg-scrim/10 absolute inset-0 grid place-items-center opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                aria-hidden="true"
              >
                <IconBadge tone="solid" size="md" className="shadow-lg">
                  <Icon
                    name="heroicons:play-solid"
                    class="size-4 translate-x-px"
                  />
                </IconBadge>
              </span>
            </span>

            <span class="min-w-0">
              <h3 lang="ar" dir="rtl" class="ui-card-title line-clamp-2">
                {episode.title}
              </h3>
              <span class="ui-meta mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="inline-flex items-center gap-1.5">
                  <Icon
                    name="heroicons:eye"
                    class="size-4"
                    aria-hidden="true"
                  />
                  {formatViews(episode.viewCount)} views
                </span>
                <span class="inline-flex items-center gap-1.5">
                  YouTube
                  <Icon
                    name="heroicons:arrow-up-right"
                    class="size-4"
                    aria-hidden="true"
                  />
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <p class="ui-meta mt-4">
      Approximate public YouTube views, captured {capturedDate}. Ranked among
      {snapshot.recordedCount} of {snapshot.eligibleCount} long-form catalog
      stories. Views are not unique viewers.{' '}
      <a href={snapshot.source} class="underline underline-offset-4">
        Source: YouTube
      </a>
    </p>
  </section>
)}
