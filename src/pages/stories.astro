---
import { SEO } from 'astro-seo'
import EditorialHeader from '../components/EditorialHeader.astro'
import StoryBrowser from '../components/StoryBrowser'
import BrandedPageDocument from '../layouts/BrandedPageDocument.astro'
import { resolveVisitedPlaces } from '../lib/visited-places'
import { siteConfig } from '../lib/site-config'
import { buildStories } from '../lib/story-browser'

const stories = buildStories(resolveVisitedPlaces(siteConfig.visitedPlaces))
const canonicalUrl = new URL('/stories', Astro.site).toString()
---

<BrandedPageDocument
  bodyClass="bg-background text-foreground min-h-screen text-lg subpixel-antialiased"
>
  <Fragment slot="head">
    <SEO
      title={`Story Browser | ${siteConfig.site.siteName}`}
      description="Browse Ya Hala stories by state and city."
      canonical={canonicalUrl}
    />
  </Fragment>
    <EditorialHeader />
    <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
      <header class="max-w-3xl">
        <p class="text-primary text-sm font-bold tracking-widest uppercase">
          Ya Hala stories
        </p>
        <h1
          class="text-foreground mt-2 text-3xl font-bold tracking-tight sm:text-5xl"
        >
          Story Browser
        </h1>
        <p
          class="text-muted-foreground mt-4 text-base leading-relaxed sm:text-lg"
        >
          Browse community stories across the United States, then filter by
          state and city. Your selected location stays in the URL so it is easy
          to share.
        </p>
      </header>
      <section class="mt-8" aria-label="Story filters and results">
        <StoryBrowser client:only="react" stories={stories} />
      </section>
    </main>
</BrandedPageDocument>
