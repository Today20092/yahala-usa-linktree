---
import { SEO } from 'astro-seo'
import StoryBrowser from '../components/StoryBrowser'
import { Card, CardContent } from '../components/ui/card'
import { Skeleton } from '../components/ui/skeleton'
import SiteFooter from '../components/SiteFooter.astro'
import TextReveal from '../components/TextReveal.astro'
import BrandedPageDocument from '../layouts/BrandedPageDocument.astro'
import Container from '../components/layout/Container.astro'
import PageHeader from '../components/layout/PageHeader.astro'
import { resolveVisitedPlaces } from '../lib/visited-places'
import { siteConfig, socialSeo } from '../lib/site-config'
import { buildStories } from '../lib/story-browser'

const visitedPlaces = resolveVisitedPlaces(siteConfig.visitedPlaces)
const stories = buildStories(visitedPlaces)
const canonicalUrl = new URL('/stories', Astro.site).toString()
---

<BrandedPageDocument bodyClass="bg-background text-foreground min-h-screen text-lg subpixel-antialiased">
  <Fragment slot="head">
    <SEO
      title={`Story Browser | ${siteConfig.site.siteName}`}
      description="Browse Ya Hala stories by state and city."
      canonical={canonicalUrl}
      {...socialSeo('stories', {
        title: `Story Browser | ${siteConfig.site.siteName}`,
        description: 'Browse Ya Hala stories by state and city.',
        url: canonicalUrl,
        alt: 'Ya Hala share card for the Story Browser',
        baseUrl: import.meta.env.BASE_URL,
        origin: Astro.site,
      })}
    />
  </Fragment>
  <Container
    as="main"
    size="wide"
    id="main-content"
    tabindex="-1"
    class="py-8 lg:px-6 lg:py-12"
  >
    <PageHeader eyebrow="Ya Hala stories">
      <TextReveal slot="title" text="Story Browser" preset="slide" />
      <p slot="description">
        Meet the people behind local businesses and Arab-American communities.
        Find a story by state or city, then watch the full episode.
      </p>
    </PageHeader>
    <section class="mt-8" aria-label="Story filters and results">
      <StoryBrowser
        client:only="react"
        stories={stories}
        places={visitedPlaces.mapPlaces ?? []}
      >
        <div slot="fallback" aria-busy="true">
          {/* Same grid, filter bar and card media ratio as StoryBrowser so the footer does not jump on mount. */}
          <div aria-hidden="true">
            <div class="border-border bg-card grid gap-4 rounded-xl border p-4 sm:grid-cols-2 sm:p-5 lg:grid-cols-3">
              {[0, 1, 2].map(() => (
                <Skeleton className="h-20 sm:h-[5.375rem] motion-reduce:animate-none" />
              ))}
            </div>
            <Skeleton className="mt-5 h-11 motion-reduce:animate-none" />
            <Skeleton className="mt-5 h-5 w-64 max-w-full motion-reduce:animate-none" />
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {[0, 1, 2, 3, 4, 5].map(() => (
                <Card className="gap-0 py-0">
                  <Skeleton className="aspect-video rounded-b-none motion-reduce:animate-none" />
                  <CardContent className="flex h-[10.5rem] flex-col sm:h-[10.875rem] gap-3 py-4">
                    <Skeleton className="h-6 w-3/4 motion-reduce:animate-none" />
                    <Skeleton className="h-4 w-1/2 motion-reduce:animate-none" />
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
          <p class="text-muted-foreground mt-6">
            Story filters are loading and require JavaScript.
            <a
              class="text-primary underline"
              href={siteConfig.youtubeChannels[0].videosUrl}
            >
              Browse all Ya Hala stories on YouTube
            </a>
            .
          </p>
        </div>
      </StoryBrowser>
    </section>
  </Container>
  <SiteFooter />
</BrandedPageDocument>
