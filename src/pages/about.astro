---
import '../typeset.css'

import { Picture } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { SEO } from 'astro-seo'

import haithemHeadshot from '../assets/haithem-alqahaf-headshot.jpg'
import EditorialMotion from '../components/EditorialMotion.astro'
import TextReveal from '../components/TextReveal.astro'
import MostWatchedStories from '../components/MostWatchedStories.astro'
import { buttonVariants } from '../components/ui/button'
import SiteFooter from '../components/SiteFooter.astro'
import ContactCta from '../components/ContactCta.astro'
import BrandedPageDocument from '../layouts/BrandedPageDocument.astro'
import { getBaseUrl, getPageOgImage, siteConfig } from '../lib/site-config'

const { about, site, socialLinks, socialReach } = siteConfig
const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
const canonicalUrl = new URL(`${baseUrl}about`, Astro.site).toString()
const homeUrl = new URL(baseUrl, Astro.site).toString()
const imageUrl = getPageOgImage('about', baseUrl, Astro.site)
const totalReach = socialReach.items.reduce((sum, item) => sum + item.value, 0)
const compactReach = new Intl.NumberFormat('en-US', {
  notation: 'compact',
  maximumFractionDigits: 0,
}).format(totalReach)

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonicalUrl}#profile-page`,
  url: canonicalUrl,
  name: about.pageTitle,
  description: about.pageDescription,
  image: imageUrl,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    url: homeUrl,
    name: site.siteName,
  },
  mainEntity: {
    '@type': 'Person',
    '@id': `${canonicalUrl}#haithem`,
    name: about.name,
    description: about.heroStatement,
    url: canonicalUrl,
    sameAs: socialLinks.map((link) => link.url),
    jobTitle: 'Host and storyteller',
  },
}
---

<BrandedPageDocument bodyClass="bg-background text-foreground min-h-screen text-lg subpixel-antialiased">
  <Fragment slot="head">
    <SEO
      title={about.pageTitle}
      description={about.pageDescription}
      canonical={canonicalUrl}
      robotsExtras="max-image-preview:large, max-snippet:-1"
      openGraph={{
        basic: {
          title: about.pageTitle,
          type: 'profile',
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: about.pageDescription,
          siteName: site.siteName,
          locale: 'en_US',
        },
        image: {
          width: 1200,
          height: 630,
          alt: `Ya Hala share card for ${about.name}`,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: site.twitterHandle,
        creator: site.twitterHandle,
        title: about.pageTitle,
        description: about.pageDescription,
        image: imageUrl,
        imageAlt: `Ya Hala share card for ${about.name}`,
      }}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <main id="main-content" tabindex="-1" class="[overflow-wrap:anywhere]">
    <EditorialMotion />
    <section
      class="mx-auto grid w-full max-w-7xl items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 lg:px-8 lg:py-16"
      aria-labelledby="about-title"
    >
      <div class="max-w-2xl">
        <p class="ui-kicker-accent">
          Meet the host ·{' '}
          <span lang="ar" dir="rtl">
            ياهلا مع هيثم
          </span>
        </p>
        <h1 id="about-title" class="ui-page-title mt-4">
          <TextReveal text={`I'm ${about.name}.`} />
        </h1>
        <p class="text-foreground mt-4 max-w-xl text-base leading-7 font-semibold sm:mt-5 sm:text-xl sm:leading-relaxed">
          The host and storyteller behind Ya Hala.
        </p>
        <p class="text-muted-foreground mt-4 max-w-xl text-base leading-relaxed sm:text-lg">
          {about.heroStatement}
        </p>
        <p class="text-muted-foreground mt-4 max-w-xl text-base leading-relaxed sm:text-lg">
          My background is in accounting, business management, and consulting.
          Today, Ya Hala is my full-time work: meeting the people behind local
          businesses and sharing their stories with our community.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`${baseUrl}contact`}
            class={buttonVariants({
              className:
                'h-auto min-h-12 max-w-full px-6 py-3 text-base whitespace-normal',
            })}
          >
            {about.partnerCtaLabel}
          </a>
          <a
            href="#journey-title"
            class={buttonVariants({
              variant: 'outline',
              className:
                'h-auto min-h-12 min-w-0 max-w-full px-6 py-3 text-center text-base whitespace-normal',
            })}
          >
            Get to know me
            <Icon
              name="heroicons:arrow-right"
              class="size-4"
              aria-hidden="true"
            />
          </a>
          <a
            href={`${baseUrl}stories`}
            class={buttonVariants({
              variant: 'link',
              className:
                'h-auto min-h-12 min-w-0 max-w-full px-3 py-3 text-center text-base whitespace-normal underline',
            })}
          >
            {about.viewerCtaLabel}
          </a>
        </div>
      </div>

      <figure class="bg-muted relative mx-auto aspect-[4/5] w-full max-w-sm overflow-hidden rounded-2xl">
        <Picture
          src={haithemHeadshot}
          alt={`Portrait of ${about.name}`}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720, 960]}
          sizes="(min-width: 416px) 384px, calc(100vw - 32px)"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section
      class="border-border/70 mx-auto grid w-full max-w-7xl gap-8 border-t px-4 py-12 sm:px-6 lg:grid-cols-[0.72fr_1.28fr] lg:px-8 lg:py-16"
      aria-labelledby="journey-title"
    >
      <div>
        <p class="ui-kicker-accent">My journey</p>
        <h2 id="journey-title" class="ui-section-title mt-3 scroll-mt-28">
          <TextReveal text="Why I started Ya Hala" preset="slide" />
        </h2>
      </div>
      <div data-scroll-section class="typeset typeset-about max-w-prose">
        {about.story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <section
      class="ui-surface-card mx-auto w-[calc(100%-2rem)] max-w-7xl px-6 py-10 sm:w-[calc(100%-3rem)] sm:px-8 lg:px-12 lg:py-14"
      aria-labelledby="viewer-value-title"
    >
      <h2 id="viewer-value-title" class="ui-section-title max-w-xl">
        <TextReveal text="What you'll find on Ya Hala" preset="slide" />
      </h2>
      <div class="mt-10 grid gap-0 md:grid-cols-3">
        {about.viewerValue.map((value, index) => (
          <div
            data-scroll-section
            class:list={[
              'border-border py-6 md:px-7 md:py-2',
              index > 0 && 'border-t md:border-t-0 md:border-l',
              index === 0 && 'md:pl-0',
            ]}
          >
            <p class="text-foreground text-base leading-7 font-semibold">
              {value}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section
      class="mx-auto grid w-full max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[0.72fr_1.28fr] lg:px-8 lg:py-16"
      aria-labelledby="mission-title"
    >
      <div>
        <p class="ui-kicker-accent">What Ya Hala means to me</p>
        <h2 id="mission-title" class="ui-section-title mt-3 max-w-xl">
          Everyone is <span data-text-highlight>welcome.</span>
        </h2>
      </div>
      <div class="typeset typeset-about max-w-prose">
        {about.mission.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <section
      class="border-border/70 mx-auto w-full max-w-7xl border-t px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
      aria-labelledby="selection-title"
    >
      <h2 id="selection-title" class="ui-section-title max-w-xl">
        What makes a story worth sharing?
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {about.selectionPrinciples.map((principle) => (
          <article data-scroll-section class="ui-surface-card p-6">
            <h3 class="ui-card-title">{principle.title}</h3>
            <p class="text-muted-foreground mt-4 max-w-xl text-base leading-7">
              {principle.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <MostWatchedStories />

    <aside
      class="text-muted-foreground mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-sm sm:px-6 lg:px-8"
      aria-label="Ya Hala reach"
    >
      <p>
        <strong class="text-foreground">{compactReach}+ views</strong> across
        official Ya Hala channels
      </p>
      <p>Updated {socialReach.updatedAt}</p>
    </aside>

    <ContactCta
      eyebrow="Contact Ya Hala"
      title="Let’s tell the story behind your business."
      body="Have a business to introduce, a sponsorship in mind, or a community story worth sharing? Tell us what you hope to achieve, and we’ll discuss whether it’s a fit for Ya Hala."
    />
  </main>

  <SiteFooter />
</BrandedPageDocument>
