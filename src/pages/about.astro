---
import '../typeset.css'

import { Picture } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { SEO } from 'astro-seo'

import haithemHeadshot from '../assets/haithem-alqahaf-headshot.jpg'
import BrandedPageDocument from '../layouts/BrandedPageDocument.astro'
import { getBaseUrl, resolveSiteAsset, siteConfig } from '../lib/site-config'

const { about, site, socialLinks, socialReach } = siteConfig
const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
const canonicalUrl = new URL(`${baseUrl}about`, Astro.site).toString()
const homeUrl = new URL(baseUrl, Astro.site).toString()
const imageUrl = new URL(
  resolveSiteAsset(baseUrl, site.ogImage),
  Astro.site,
).toString()
const instagramUrl =
  socialLinks.find((link) => link.id === 'instagram')?.url ?? homeUrl
const totalReach = socialReach.items.reduce((sum, item) => sum + item.value, 0)
const compactReach = new Intl.NumberFormat('en-US', {
  notation: 'compact',
  maximumFractionDigits: 0,
}).format(totalReach)
const currentYear = new Date().getFullYear()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonicalUrl}#profile-page`,
  url: canonicalUrl,
  name: about.pageTitle,
  description: about.pageDescription,
  image: imageUrl,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    url: homeUrl,
    name: site.siteName,
  },
  mainEntity: {
    '@type': 'Person',
    '@id': `${canonicalUrl}#haithem`,
    name: about.name,
    description: about.heroStatement,
    url: canonicalUrl,
    sameAs: socialLinks.map((link) => link.url),
    jobTitle: 'Host and storyteller',
  },
}
---

<BrandedPageDocument
  bodyClass="bg-background text-foreground min-h-screen text-lg subpixel-antialiased"
>
  <Fragment slot="head">
    <SEO
      title={about.pageTitle}
      description={about.pageDescription}
      canonical={canonicalUrl}
      robotsExtras="max-image-preview:large, max-snippet:-1"
      openGraph={{
        basic: {
          title: about.pageTitle,
          type: 'profile',
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: about.pageDescription,
          siteName: site.siteName,
          locale: 'en_US',
        },
        image: {
          width: 1200,
          height: 630,
          alt: `Ya Hala cover artwork featuring ${about.name}`,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: site.twitterHandle,
        creator: site.twitterHandle,
        title: about.pageTitle,
        description: about.pageDescription,
        image: imageUrl,
        imageAlt: `Ya Hala cover artwork featuring ${about.name}`,
      }}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>
    <header class="mx-auto w-full max-w-7xl px-4 pt-5 sm:px-6 lg:px-8">
      <nav
        class="flex min-h-14 items-center justify-between gap-4"
        aria-label="Primary navigation"
      >
        <a
          href={baseUrl}
          class="text-foreground focus-visible:ring-ring rounded-sm text-base font-bold tracking-tight focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:outline-none"
        >
          Ya Hala
        </a>
        <div class="flex items-center gap-5 text-sm font-semibold">
          <a
            href={baseUrl}
            class="text-muted-foreground hover:text-foreground focus-visible:ring-ring rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:outline-none"
          >
            Home
          </a>
          <a
            href={`${baseUrl}stories`}
            class="text-muted-foreground hover:text-foreground focus-visible:ring-ring rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:outline-none"
          >
            Stories
          </a>
        </div>
      </nav>
    </header>

    <main>
      <section
        class="mx-auto grid min-h-[calc(100dvh-4.75rem)] w-full max-w-7xl items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-14"
        aria-labelledby="about-title"
      >
        <div class="max-w-2xl">
          <p class="text-primary text-sm font-bold tracking-[0.16em] uppercase">
            About Haithem | ياهلا مع هيثم
          </p>
          <h1
            id="about-title"
            class="text-foreground mt-4 text-4xl leading-[1.02] font-bold tracking-[-0.045em] text-balance sm:text-6xl"
          >
            Stories can move a community forward.
          </h1>
          <p
            class="text-foreground mt-4 max-w-xl text-base leading-7 font-semibold sm:mt-5 sm:text-xl sm:leading-relaxed"
          >
            {about.role}
          </p>
          <p
            class="text-muted-foreground mt-4 max-w-xl text-base leading-relaxed sm:text-lg"
          >
            {about.heroStatement}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={`${baseUrl}stories`}
              class="bg-foreground text-background hover:bg-foreground/90 focus-visible:ring-ring inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 text-base font-semibold whitespace-nowrap transition-[background-color,transform] hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-0"
            >
              {about.viewerCtaLabel}
              <Icon
                name="heroicons:arrow-right"
                class="size-4"
                aria-hidden="true"
              />
            </a>
          </div>
        </div>

        <div
          class="bg-muted relative mx-auto aspect-[4/5] w-full max-w-lg overflow-hidden rounded-2xl"
        >
          <Picture
            src={haithemHeadshot}
            alt={`Portrait of ${about.name}`}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 42vw, 92vw"
            class="h-full w-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>

      <section
        class="border-border/70 mx-auto grid w-full max-w-7xl gap-8 border-t px-4 py-16 sm:px-6 lg:grid-cols-[0.72fr_1.28fr] lg:px-8 lg:py-24"
        aria-labelledby="journey-title"
      >
        <div>
          <p class="text-primary text-sm font-bold">My journey</p>
          <h2
            id="journey-title"
            class="text-foreground mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
          >
            From experience to influence
          </h2>
        </div>
        <div class="typeset typeset-about max-w-3xl">
          {about.story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section
        class="bg-muted/45 mx-auto w-full max-w-7xl rounded-2xl px-4 py-14 sm:px-8 lg:px-12 lg:py-20"
        aria-labelledby="viewer-value-title"
      >
        <h2
          id="viewer-value-title"
          class="text-foreground max-w-xl text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Useful stories for real life
        </h2>
        <div class="mt-10 grid gap-0 md:grid-cols-3">
          {
            about.viewerValue.map((value, index) => (
              <div
                class:list={[
                  'border-border py-6 md:px-7 md:py-2',
                  index > 0 && 'border-t md:border-t-0 md:border-l',
                  index === 0 && 'md:pl-0',
                ]}
              >
                <p class="text-foreground text-base leading-7 font-semibold">
                  {value}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="mx-auto w-full max-w-5xl px-4 py-20 text-center sm:px-6 lg:py-28"
        aria-labelledby="mission-title"
      >
        <p class="text-primary text-sm font-bold">Everyone is welcome</p>
        <h2
          id="mission-title"
          class="text-foreground mx-auto mt-4 max-w-3xl text-3xl leading-tight font-bold tracking-tight text-balance sm:text-5xl"
        >
          Different backgrounds. Shared values. One stronger community.
        </h2>
        <div class="typeset typeset-about mx-auto mt-8 max-w-3xl">
          {about.mission.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section
        class="border-border/70 mx-auto w-full max-w-7xl border-t px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
        aria-labelledby="selection-title"
      >
        <h2
          id="selection-title"
          class="text-foreground max-w-xl text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Every feature needs a reason
        </h2>
        <div class="mt-10 grid gap-5 lg:grid-cols-12">
          {
            about.selectionPrinciples.map((principle, index) => (
              <article
                class:list={[
                  'border-border bg-card rounded-2xl border p-7',
                  index === 0 ? 'lg:col-span-7 lg:row-span-2' : 'lg:col-span-5',
                ]}
              >
                <h3
                  class:list={[
                    'text-foreground font-bold tracking-tight',
                    index === 0 ? 'text-3xl sm:text-4xl' : 'text-2xl',
                  ]}
                >
                  {principle.title}
                </h3>
                <p class="text-muted-foreground mt-4 max-w-xl text-base leading-7">
                  {principle.description}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="bg-primary text-primary-foreground mx-auto mb-8 w-[calc(100%-2rem)] max-w-7xl rounded-2xl px-6 py-14 sm:w-[calc(100%-3rem)] sm:px-10 lg:px-14 lg:py-16"
        aria-labelledby="cta-title"
      >
        <div class="grid items-end gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="text-primary-foreground/80 text-sm font-bold">
              Come along
            </p>
            <h2
              id="cta-title"
              class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-balance sm:text-5xl"
            >
              Get inspired, support good work, and take action.
            </h2>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href={`${baseUrl}stories`}
              class="bg-background text-foreground focus-visible:ring-ring inline-flex min-h-12 items-center justify-center rounded-full px-6 text-base font-bold whitespace-nowrap transition-transform hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-0"
            >
              {about.viewerCtaLabel}
            </a>
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10 focus-visible:ring-ring inline-flex min-h-12 items-center justify-center rounded-full border px-6 text-base font-bold whitespace-nowrap transition-[background-color,transform] hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-0"
            >
              {about.partnerCtaLabel}
            </a>
          </div>
        </div>
      </section>

      <aside
        class="text-muted-foreground mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-sm sm:px-6 lg:px-8"
        aria-label="Ya Hala reach"
      >
        <p>
          <strong class="text-foreground">{compactReach}+ views</strong>
          {' '}across official Ya Hala channels
        </p>
        <p>Updated {socialReach.updatedAt}</p>
      </aside>
    </main>

    <footer
      class="border-border/70 mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 border-t px-4 py-8 text-sm sm:px-6 lg:px-8"
    >
      <p class="text-muted-foreground">
        &copy; {currentYear} Ya Hala with Haithem
      </p>
      <nav class="flex gap-5 font-semibold" aria-label="Footer navigation">
        <a href={baseUrl} class="hover:text-primary transition-colors">Home</a>
        <a
          href={`${baseUrl}stories`}
          class="hover:text-primary transition-colors"
        >
          Stories
        </a>
      </nav>
    </footer>
</BrandedPageDocument>
